
<% layout("/layouts/boilerplate") %>

<%
  const _placeholders = [
    "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=1200&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=1200&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1501594907352-04cda38ebc29?w=1200&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1496417263034-38ec4f0b665a?w=1200&q=80&auto=format&fit=crop"
  ];

  function _ph() {
    return _placeholders[
      Math.floor(Math.random() * _placeholders.length)
    ];
  }
%>

<div class="container show-container">

  <!-- Main Listing -->
  <div class="listing-show-card">

    <!-- Image -->
    <div class="listing-image-wrapper">
      <img
        src="<%= listing.image && listing.image.url ? listing.image.url : _ph() %>"
        class="listing-show-image"
        alt="<%= listing.title %>"
      />

      <div class="image-overlay"></div>

      <div class="listing-image-title">
        <h1><%= listing.title %></h1>
      </div>
    </div>


    <!-- Listing Details -->
    <div class="listing-details">

      <div class="listing-description">
        <h3>About this place</h3>

        <p>
          <%= listing.description %>
        </p>
      </div>


      <!-- Info Grid -->
      <div class="listing-info-grid">

        <div class="info-box">
          <div class="info-icon">₹</div>

          <div>
            <span>Price</span>
            <strong>
              <%= listing.price != null
                ? "₹" + Number(listing.price).toLocaleString("en-IN")
                : "N/A"
              %>
            </strong>
          </div>
        </div>


        <div class="info-box">
          <div class="info-icon">📍</div>

          <div>
            <span>Location</span>
            <strong>
              <%= listing.location %>
            </strong>
          </div>
        </div>


        <div class="info-box">
          <div class="info-icon">🌎</div>

          <div>
            <span>Country</span>
            <strong>
              <%= listing.country %>
            </strong>
          </div>
        </div>

      </div>


      <!-- Actions -->
      <div class="listing-actions">

        <a
          href="/listings/<%= listing._id %>/edit"
          class="btn-edit"
        >
          Edit Listing
        </a>


        <form
          method="POST"
          action="/listings/<%= listing._id %>?_method=DELETE"
        >
          <button
            type="submit"
            class="btn-delete"
            onclick="return confirm('Are you sure you want to delete this listing?');"
          >
            Delete
          </button>
        </form>


        <a
          href="/listings"
          class="btn-back"
        >
          ← Back to Listings
        </a>

      </div>

    </div>


    <!-- Review Section -->
    <div class="reviews-section">

      <div class="section-heading">
        <div>
          <h2>Leave a Review</h2>
          <p>Share your experience with other travelers.</p>
        </div>
      </div>


      <form
        method="POST"
        action="/listings/<%= listing._id %>/reviews"
        class="review-form"
      >

        <!-- Review -->
        <div class="form-group">

          <label for="review">
            Your Review
          </label>

          <textarea
            id="review"
            name="review[comment]"
            rows="4"
            placeholder="Tell us about your experience..."
            required
          ></textarea>

        </div>


        <!-- Rating -->
        <div class="form-group">

          <label for="rating">
            Rating
          </label>

          <select
            id="rating"
            name="review[rating]"
            required
          >

            <option value="" disabled selected>
              Select your rating
            </option>

            <% for (let i = 1; i <= 5; i++) { %>

              <option value="<%= i %>">
                <%= i %> Star<%= i > 1 ? "s" : "" %>
              </option>

            <% } %>

          </select>

        </div>


        <button
          type="submit"
          class="submit-review-btn"
        >
          Submit Review
        </button>

      </form>

    </div>


    <!-- Existing Reviews -->
    <div class="reviews-section existing-reviews">

      <div class="section-heading">

        <div>
          <h2>Guest Reviews</h2>

          <p>
            <% if (listing.reviews && listing.reviews.length > 0) { %>
              <%= listing.reviews.length %>
              <%= listing.reviews.length === 1 ? "review" : "reviews" %>
            <% } else { %>
              Be the first to review this place
            <% } %>
          </p>

        </div>

      </div>


      <% if (listing.reviews && listing.reviews.length > 0) { %>

        <div class="reviews-grid">

          <% listing.reviews.forEach(review => { %>

            <div class="review-card">

              <div class="review-header">

                <div class="review-avatar">
                  <%= review.comment ? review.comment.charAt(0).toUpperCase() : "G" %>
                </div>

                <div>
                  <strong>Guest</strong>

                  <div class="review-stars">

                    <% for (let i = 1; i <= 5; i++) { %>

                      <% if (i <= review.rating) { %>
                        <span class="star filled">★</span>
                      <% } else { %>
                        <span class="star">☆</span>
                      <% } %>

                    <% } %>

                  </div>

                </div>

              </div>


              <p class="review-text">
                <%= review.comment %>
              </p>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="no-reviews">
          <div class="no-review-icon">💬</div>

          <h3>No reviews yet</h3>

          <p>
            Be the first person to share your experience.
          </p>
        </div>

      <% } %>

    </div>

  </div>

</div>

