<div id="flash-container" aria-live="polite" aria-atomic="true">
  <% const successMessages = Array.isArray(success) ? success : [success].filter(Boolean); %>
  <% successMessages.forEach((message) => { %>
    <div class="flash-alert alert flash-alert-success alert-dismissible fade show" role="alert">
      <div class="flash-message-content">
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        <span><%= message %></span>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }); %>

  <% const errorMessages = Array.isArray(error) ? error : [error].filter(Boolean); %>
  <% errorMessages.forEach((message) => { %>
    <div class="flash-alert alert flash-alert-danger alert-dismissible fade show" role="alert">
      <div class="flash-message-content">
        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
        <span><%= message %></span>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }); %>
</div>